# OpenGander Web Application Environment Variables

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# JWT Configuration
# HS256 secret (used as fallback if RS256 keys not configured)
JWT_SECRET=your-secret-key-at-least-32-characters-long

# RS256 JWT Keys (PEM-encoded, newlines as \n)
# Generate with: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
# Then convert to single line: awk 'NF {sub(/\r/, ""); printf "%s\\n",$0;}' private.pem
# JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# JWT_KEY_ID="opengander-2025-01"

# Key Rotation (optional - set when rotating RSA keys)
# Copy current JWT_PUBLIC_KEY and JWT_KEY_ID here before deploying new keys.
# Remove after old tokens expire (7 days for sessions).
# JWT_PREVIOUS_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# JWT_PREVIOUS_KEY_ID="opengander-2025-01"

# Session Configuration
SESSION_MAX_AGE=604800  # 7 days in seconds

# ClickHouse Database
# Set CLICKHOUSE_MODE=sqlite for local dev without ClickHouse
# CLICKHOUSE_MODE=sqlite
CLICKHOUSE_HOST=localhost
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default

# Email Configuration
# Provider: mock (default), ses, or mailgun
EMAIL_PROVIDER=mock

# AWS SES Configuration (if EMAIL_PROVIDER=ses)
# SES_FROM_EMAIL=noreply@opengander.com
# AWS_REGION=us-east-1

# Mailgun Configuration (if EMAIL_PROVIDER=mailgun)
# MAILGUN_API_KEY=your-mailgun-api-key
# MAILGUN_DOMAIN=mg.opengander.com
# MAILGUN_FROM_EMAIL=noreply@opengander.com

# Waitlist notification email
# WAITLIST_NOTIFY_EMAIL=sales@opengander.com

# Registration
# REGISTRATION_DISABLED=true

# Stripe
# For local dev, run `npm run stripe:env` at the repo root to pull
# STRIPE_SECRET_KEY and NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY from the
# opengander/stripe/test secret into .env.local automatically.
# STRIPE_WEBHOOK_SECRET comes from `stripe listen` — paste the whsec_...
# it prints on startup into .env.local.
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID_MONTHLY=price_...
# STRIPE_PRICE_ID_ANNUAL=price_...
