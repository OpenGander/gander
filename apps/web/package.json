    "echarts-for-react": "^3.0.5",
    "form-data": "^4.0.5",
    "jose": "^6.1.3",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "mailgun.js": "^12.7.0",
    "next": "^15.1.0",
    "next-themes": "^0.4.6",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-window": "^2.2.3",
