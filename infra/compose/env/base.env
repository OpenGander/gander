# Safe development defaults for the self-hosted stack. Override real secrets in
# infra/compose/env/local.env (gitignored) for anything beyond local dev.

# --- ClickHouse (telemetry store) ---
# App queries over HTTP (8123); the collector exporter uses native TCP (9000).
CLICKHOUSE_ENDPOINT=tcp://clickhouse:9000
CLICKHOUSE_USER=otel
CLICKHOUSE_PASSWORD=otel
CLICKHOUSE_DATABASE=opengander

# --- Postgres (control plane: tenants, users, auth) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=opengander
POSTGRES_PASSWORD=opengander
POSTGRES_DB=opengander

# --- Ingestion auth ---
OTEL_API_KEY_PUBLIC=dev-public-key
OTEL_API_KEY_PRIVATE=dev-private-key
OTEL_TOKEN_SECRET=dev-secret-minimum-64-chars-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
TOKEN_TTL=300

# --- Web app ---
# Web session / magic-link signing secret (independent of the telemetry secret).
JWT_SECRET=dev-session-secret-minimum-64-chars-bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
# Email: 'mock' (logs the magic link to stdout), 'smtp', 'mailgun'. See docs/usage.md.
EMAIL_PROVIDER=mock
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3003
