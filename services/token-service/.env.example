# Token Service environment configuration.
# Copy this file to .env and replace placeholder values before running.
#   cp .env.example .env

# --- Core ---
OTEL_TOKEN_SECRET=replace-with-a-long-random-secret-min-64-chars
PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000
TOKEN_TTL=300
CLOCK_SKEW_TOLERANCE=60
LOG_LEVEL=debug

# --- ClickHouse ---
CLICKHOUSE_PROTOCOL=http
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=opengander

# --- OpenTelemetry instrumentation ---
OTEL_SERVICE_NAME=token-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_LOG_LEVEL=info
SERVICE_VERSION=0.0.0
