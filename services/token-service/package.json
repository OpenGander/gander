{
  "name": "otel-token-service",
  "version": "1.0.0",
  "description": "Short-lived JWT token generation service for OpenTelemetry browser telemetry",
  "main": "index.js",
  "scripts": {
    "start": "node --require ./instrumentation.js index.js",
    "start:no-otel": "node index.js",
    "dev": "nodemon --require ./instrumentation.js index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [
    "opentelemetry",
    "jwt",
    "token",
    "authentication"
  ],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.56.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.57.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.0",
    "@opentelemetry/resources": "^1.30.0",
    "@opentelemetry/sdk-metrics": "^1.30.0",
    "@opentelemetry/sdk-node": "^0.57.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.2.0",
    "nodemon": "^3.0.2",
    "pino-pretty": "^13.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
