# ClickHouse connection settings
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=otel
CLICKHOUSE_PASSWORD=otel
CLICKHOUSE_DATABASE=opengander

# MCP Server settings
MCP_LOG_LEVEL=INFO
MCP_PORT=8000

# Development settings
# Set to 'development' for verbose logging
ENV=production

# =============================================================================
# JWT Authentication
# =============================================================================

# HS256 Session Token Validation (same secret as web app)
# REQUIRED for session token auth: Must match the JWT_SECRET from apps/web/.env
# Generate with: openssl rand -hex 32
JWT_SECRET=

# RS256 OAuth Token Validation (fetches public key from JWKS)
# REQUIRED for OAuth token auth: URL to fetch JWKS from
JWKS_URI=https://app.example.com/api/.well-known/jwks.json

# OAuth 2.1 Protected Resource Metadata (RFC 9728)
# These define the resource and authorization server URIs for OAuth discovery
MCP_RESOURCE_URI=https://mcp.example.com
ISSUER=https://app.example.com

# Legacy: Authorization server URI (used for OAuth discovery)
AUTHORIZATION_SERVER_URI=https://app.example.com
